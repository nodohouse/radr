# Copy to .env.local for local development.
# Never commit real secrets. Placeholders only.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Database
# Leave unset to use embedded PGlite under .data/pglite (good for local V0).
# Or point at Postgres:
# DATABASE_URL=postgresql://prep:prep@127.0.0.1:5432/prep
# PGLITE_DATA_DIR=.data/pglite

# Storage: private only. Default: local filesystem under .data/uploads
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# S3-compatible private bucket (AWS S3, Cloudflare R2, MinIO)
# STORAGE_DRIVER=s3
# S3_BUCKET=prep-documents
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Feature flags
FEATURE_DOCUMENT_CHECKING=false
# Live Shift: illustrative stream in DEMO. LIVE requires feeds ready.
# NEXT_PUBLIC_FEATURE_LIVE_SHIFT=true
# NEXT_PUBLIC_LIVE_SHIFT_FEEDS=false

# RADR environment: DEMO | SANDBOX | LIVE
# Default DEMO. Never set LIVE unless real customer data + auth gate are ready.
# NEXT_PUBLIC_RADR_ENV=DEMO
# NEXT_PUBLIC_RADR_SANDBOX_LIVE=false

# Set true only after a transactional email provider is wired
# EMAIL_PROVIDER_CONFIGURED=false

# Optional marketing contact webhook (server-side only)
# CONTACT_WEBHOOK_URL=

# --- RADR API (PROPOSED · not live until handlers ship) ---
# RADR_ENV=development
# RADR_API_BASE_URL=https://api.example.invalid
# RADR_API_KEY=radr_test_your_test_api_key

# Encryption key for future integration credentials (server-side only)
# INTEGRATION_ENCRYPTION_KEY=replace_with_secure_local_value

# Optional Ask RADR LLM (server-side only — never NEXT_PUBLIC_)
# Enables natural-language intent understanding + tool selection.
# Without it, Ask RADR still answers from the deterministic planner + demo tools.
# Numbers always come from RADR tools — never from the model.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional marketing socials (public). Leave empty until real profiles exist.
# NEXT_PUBLIC_RADR_LINKEDIN_URL=
# NEXT_PUBLIC_RADR_INSTAGRAM_URL=
# NEXT_PUBLIC_RADR_X_URL=

# --- Example provider placeholders (never put real values in git) ---
# TOAST_CLIENT_ID=your_client_id
# TOAST_CLIENT_SECRET=your_client_secret
# TOAST_WEBHOOK_SECRET=your_webhook_secret
# SEVENROOMS_CLIENT_ID=your_client_id
# SEVENROOMS_CLIENT_SECRET=your_client_secret
# DEPUTY_CLIENT_ID=your_client_id
# DEPUTY_CLIENT_SECRET=your_client_secret
# DEPUTY_API_TOKEN=your_api_token
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Menu availability risk (DEMO illustrative; LIVE needs feeds)
# NEXT_PUBLIC_FEATURE_MENU_AVAILABILITY=true
# NEXT_PUBLIC_MENU_AVAILABILITY_FEEDS=false
