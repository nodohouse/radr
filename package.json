{
  "name": "prep",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:turbo": "bash scripts/dev.sh --turbopack",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3020",
    "lint": "eslint",
    "test": "vitest run",
    "i18n:check": "node scripts/check-locale-parity.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:coherence": "node scripts/check-coherence.mjs",
    "qa:product-routes": "node scripts/qa-product-routes.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "mockups:export": "node scripts/export-mockups.mjs",
    "qa:visual": "playwright test tests/e2e/public-visual-qa.spec.ts",
    "qa:crawl": "playwright test tests/e2e/role-world-full-crawl.spec.ts --project=desktop-1440",
    "qa:axe": "playwright test tests/e2e/screenshot-axe-matrix.spec.ts --project=desktop-1440"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.4",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/three": "^0.186.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "motion": "^13.1.0",
    "next": "15.5.29",
    "next-intl": "^4.14.1",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "simple-icons": "^16.32.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.52.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
